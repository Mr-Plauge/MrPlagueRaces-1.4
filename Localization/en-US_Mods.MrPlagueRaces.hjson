Conditions.LowHealth: When the player is below half HP

UI: {
	Confirm: Confirm
	ColorPaletteNotifier: Preserving Color Palette Between Race Swaps
	ButtonBack: Return to the player creation menu.
	ButtonCreate: Create your race's Mod Source Folder. Build, reload, and publish the source to put it on the Steam Workshop.
	ClothingStyles: Change your race's default clothing style.
	HairStyles: Change your race's default hairstyle. Draws from the pool of hair sheets you have uploaded.
	ColorPickers4: Modify your race's default hair color.
	ColorPickers5: Modify your race's default eye color.
	ColorPickers6: Modify your race's default skin color.
	ColorPickers7: Modify your race's default detail color(s).
	ColorPickers8: Modify your race's default shirt color.
	ColorPickers9: Modify your race's default undershirt color.
	ColorPickers10: Modify your race's default pants color.
	ColorPickers11: Modify your race's default shoe color.
	ColorPickers12: Modify your race's default detail color(s).
	ColorPickers13: Modify your race's default detail color(s).
	ColorPickers14: Modify your race's default detail color(s).
	ColorPalette: Customize your race's default vanity data. This includes clothing, hairstyle, & color palette.
	Appearance: Upload spritesheets & sound effects for your race.
	Abilities: Modify your race's stat bonuses & weaknesses.
	RaceInfo: Provide a modname, racename, and author.
	ModName: The internal name of your mod.
	ModDisplayName: The name that will be publicly displayed for your mod.
	ModAuthor: The name(s) credited in your mod's description.
	RaceName: The internal name of your race.
	RaceDisplayName: The name that will be publicly displayed for your race.
	FamiliarShirt: Toggle whether your race starts with a familiar shirt.
	FamiliarPants: Toggle whether your race starts with familiar pants.
	CensorClothing: Toggle your race's censor clothing. This can only be disabled if you have changed the body and leg sheets.
	DetailCount_1: Adjust your race's number of detail colors. Currently set to 1.
	DetailCount_2: Adjust your race's number of detail colors. Currently set to 2.
	DetailCount_3: Adjust your race's number of detail colors. Currently set to 3.
	DetailCount_4: Adjust your race's number of detail colors. Currently set to 4.
}

Keybinds: {
	"Primary Racial Ability.DisplayName": Primary  Racial  Ability
	"Secondary Racial Ability.DisplayName": Secondary  Racial  Ability
	"Tertiary Racial Ability.DisplayName": Tertiary  Racial  Ability
	"Quaternary Racial Ability.DisplayName": Quaternary  Racial  Ability
}

Items: {
	InvisibleMask: {
		DisplayName: Invisible Mask
		Tooltip: Hides your headwear
	}

	InvisibleShirt: {
		DisplayName: Invisible Shirt
		Tooltip: Hides your torsowear
	}

	InvisibleTrousers: {
		DisplayName: Invisible Trousers
		Tooltip: Hides your legwear
	}

	EntangledStrands: {
		DisplayName: Entangled Strands
		Tooltip:
			'''
			Allows a new race to be selected
			Allows for modification of the player's hair, eye, skin, & detail colors
			Allows for modification of the player's hairstyle
			Hold Down while selecting a race to preserve your color palette
			'Invisible threads made visible through the Aether'
			'''
	}
}

Configs: {
	MrPlagueRacesConfig: {
		DisplayName: Adjustments (General)

		raceStats: {
			Label: Racial Stats & Abilities
			Tooltip:
				'''
				On: Enables racial stat changes & abilities
				Off: Disables racial stat changes & abilities
				'''
		}

		statMode: {
			Label: Stat Balance
			Tooltip:
				'''
				0: [c/4DBF60:Lite - Racial stats are of minimal impact]
				1: [c/F26E0A:Medium - Racial stats slightly affect game progression]
				2: [c/FF3640:Extreme - Racial stats greatly affect game progression]
				'''
		}

		abilityMode: {
			Label: Ability Balance
			Tooltip:
				'''
				0: [c/4DBF60:Lite - Racial abilities are of minimal impact]
				1: [c/F26E0A:Medium - Racial abilities slightly affect game progression]
				2: [c/FF3640:Extreme - Racial abilities greatly affect game progression]
				'''
		}

		experimentalContent: {
			Label: Toggle Experimental Content
			Tooltip:
				'''
				On: Enables unfinished mod content
				Off: Disables unfinished mod content

				[c/4DBF60:As of 8/24/2025, this option enables (very buggy) Lihzahrd Golems in Multiplayer.]
				'''
		}

		raceHurtSounds: {
			Label: Racial Hurt Sounds
			Tooltip:
				'''
				On: Hurt sounds are replaced by custom sounds
				Off: Hurt sounds are not overridden
				'''
		}

		Headers: {
			GameplayOptions: Gameplay Options
			TechnicalOptions: Technical Options
			ExperimentalContent: Experimental Content
		}

		raceSelectionInPlayerCreationUI: {
			Label: Override Player Creation UI
			Tooltip:
				'''
				On: Player Creation UI is overridden to include race selection
				Off: Player Creation UI is not overridden (to resolve mod compatibility issues)
				'''
		}

		raceSelectionPanelHeight: {
			Label: Height Extension (Race Selection UI)
			Tooltip: Extends the visible contents of the race selection window
		}

		overrideDresserUI: {
			Label: Override Dresser UI
			Tooltip:
				'''
				On: Ingame Dresser UI is overridden to support custom player appearances
				Off: Ingame Dresser UI is not overridden
				'''
		}

		overrideHairstyleUI: {
			Label: Override Stylist UI
			Tooltip:
				'''
				On: Ingame Stylist UI is overridden to support custom player appearances
				Off: Ingame Stylist UI is not overridden
				'''
		}
	}

